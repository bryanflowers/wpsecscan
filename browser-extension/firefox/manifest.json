{
  "manifest_version": 2,
  "name": "WPSecScan wp-admin overlay",
  "version": "1.0.0",
  "description": "Highlights wp-admin pages with findings from your last WPSecScan run.",
  "permissions": ["storage", "activeTab", "<all_urls>"],
  "browser_action": {
    "default_popup": "popup.html"
  },
  "background": {"scripts": ["background.js"]},
  "content_scripts": [{
    "matches": ["*://*/wp-admin/*", "*://*/wp-login.php*"],
    "js": ["content.js"],
    "css": ["overlay.css"],
    "run_at": "document_idle"
  }],
  "browser_specific_settings": {
    "gecko": {"id": "wpsecscan-overlay@wpsecscan.dev", "strict_min_version": "109.0"}
  }
}
