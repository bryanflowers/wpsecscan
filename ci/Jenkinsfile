// Declarative Jenkins pipeline for WPSecScan
pipeline {
    agent { docker { image 'python:3.11-slim' } }

    parameters {
        string(name: 'TARGET_URL', defaultValue: '',
               description: 'WordPress URL to scan (required; scan only sites you own or are authorised to test)')
        choice(name: 'FAIL_ON', choices: ['critical', 'high', 'medium', 'low'],
               description: 'Fail the build if findings >= this severity exist')
    }

    triggers {
        cron('H 3 * * *')  // nightly at ~3am
    }

    stages {
        stage('Check target') {
            steps {
                script {
                    if (!params.TARGET_URL?.trim()) {
                        error('TARGET_URL is not set. Set it to a site you own or are authorised to test.')
                    }
                }
            }
        }
        stage('Install') {
            steps {
                sh '''
                    pip install --quiet httpx[http2] jinja2 rich openpyxl
                    git clone --depth 1 https://github.com/bryanflowers/wpsecscan.git _wpsecscan
                    pip install --quiet -e ./_wpsecscan
                '''
            }
        }
        stage('Scan') {
            steps {
                withCredentials([
                    string(credentialsId: 'wpscan-token', variable: 'WPSCAN_TOKEN'),
                    string(credentialsId: 'patchstack-token', variable: 'PATCHSTACK_TOKEN')
                ]) {
                    sh '''
                        python -m wpsecscan "${TARGET_URL}" \
                            --json-only --no-color \
                            --out ./reports \
                            --fail-on "${FAIL_ON}" \
                            ${WPSCAN_TOKEN:+--wpscan-token "$WPSCAN_TOKEN"} \
                            ${PATCHSTACK_TOKEN:+--patchstack-token "$PATCHSTACK_TOKEN"}
                    '''
                }
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'reports/**', fingerprint: true
        }
    }
}
