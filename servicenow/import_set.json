{
  "//": "Round-64 #137 — ServiceNow import-set schema for WPSecScan findings",
  "u_table_label": "WPSecScan Finding",
  "u_table_name": "u_wpsecscan_finding",
  "fields": [
    {"name": "u_finding_id",       "type": "string",   "max_length": 64, "primary_key": true},
    {"name": "u_target_url",       "type": "string",   "max_length": 1024},
    {"name": "u_severity",         "type": "choice",   "choices": ["critical","high","medium","low","info"]},
    {"name": "u_title",            "type": "string",   "max_length": 512},
    {"name": "u_evidence",         "type": "string",   "max_length": 4000},
    {"name": "u_remediation",      "type": "string",   "max_length": 4000},
    {"name": "u_finding_url",      "type": "string",   "max_length": 1024},
    {"name": "u_check_id",         "type": "string",   "max_length": 64},
    {"name": "u_scanned_at",       "type": "glide_date_time"},
    {"name": "u_compliance_tags",  "type": "string",   "max_length": 512},
    {"name": "u_cve",              "type": "string",   "max_length": 32},
    {"name": "u_cvss",             "type": "decimal",  "scale": 1},
    {"name": "u_state",            "type": "choice",   "choices": ["new","triaged","in_progress","resolved","wontfix"], "default": "new"},
    {"name": "u_assigned_to",      "type": "reference","table": "sys_user"},
    {"name": "u_priority",         "type": "choice",   "choices": ["1-critical","2-high","3-moderate","4-low","5-planning"]}
  ],
  "transform_map": {
    "name": "WPSecScan -> Security Incident",
    "target_table": "sn_si_incident",
    "field_map": [
      {"source": "u_title",       "target": "short_description"},
      {"source": "u_evidence",    "target": "description"},
      {"source": "u_severity",    "target": "severity",  "script": "u_severity_to_sn"},
      {"source": "u_finding_url", "target": "u_finding_url"},
      {"source": "u_check_id",    "target": "category", "default": "vulnerability"}
    ]
  },
  "ingestion_endpoint": "/api/now/import/u_wpsecscan_finding"
}
