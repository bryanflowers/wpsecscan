<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>WPSecScan — batch dashboard</title>
<style>
  :root {
    --bg: #0d1117; --panel: #161b22; --panel2: #1f2630;
    --fg: #e6edf3; --muted: #8b949e; --border: #30363d;
    --crit-bg: #67000d; --crit-fg: #ffd6d6;
    --high-bg: #5a1816; --high-fg: #ff8a85;
    --med-bg:  #4a3a10; --med-fg:  #f0c674;
    --low-bg:  #133246; --low-fg:  #79c0ff;
    --info-bg: #21262d; --info-fg: #8b949e;
    --ok-bg:   #133320; --ok-fg:   #6cc474;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.5 -apple-system,"Segoe UI",system-ui,sans-serif}
  header{padding:32px 24px 16px;border-bottom:1px solid var(--border)}
  header h1{margin:0 0 6px;font-size:22px}
  header .meta{color:var(--muted);font-size:13px}
  main{max-width:1400px;margin:0 auto;padding:24px}
  table{width:100%;border-collapse:collapse;margin-top:16px}
  th, td{padding:10px 14px;text-align:left;border-bottom:1px solid var(--border)}
  th{background:var(--panel);color:var(--fg);font-weight:600;cursor:pointer}
  th:hover{background:var(--panel2)}
  tr:hover{background:var(--panel)}
  .pill{display:inline-block;padding:3px 8px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
  .pill.crit{background:var(--crit-bg);color:var(--crit-fg)}
  .pill.high{background:var(--high-bg);color:var(--high-fg)}
  .pill.med {background:var(--med-bg); color:var(--med-fg)}
  .pill.low {background:var(--low-bg); color:var(--low-fg)}
  .pill.info{background:var(--info-bg);color:var(--info-fg)}
  .pill.ok  {background:var(--ok-bg);  color:var(--ok-fg)}
  .num{font-variant-numeric:tabular-nums;text-align:right}
  .num.crit{color:#ff5252;font-weight:700}
  .num.high{color:#ff8a85;font-weight:700}
  .num.med {color:#f0c674}
  .num.low {color:#79c0ff}
  .num.info{color:#8b949e}
  a{color:#79c0ff;text-decoration:none}
  a:hover{text-decoration:underline}
  .summary{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
  .spark{font-family:"Cascadia Mono","Consolas",monospace;font-size:16px;letter-spacing:1px;color:#79c0ff}
  .delta-up{color:#ff5252;font-weight:700}
  .delta-dn{color:#6cc474;font-weight:700}
  .delta-flat{color:var(--muted)}
  .brand-header{display:flex;align-items:center;gap:16px;margin-bottom:8px}
  .brand-header img{max-height:48px;max-width:160px;border-radius:4px}
  .agency-name{font-size:18px;font-weight:600;color:var(--fg)}
  footer{padding:16px 24px;color:var(--muted);font-size:12px;border-top:1px solid var(--border);text-align:center}
@media (max-width: 700px) {
  header{padding:20px 14px 12px}
  main{padding:14px}
  table{display:block;overflow-x:auto}
  table thead, table tbody{display:table;width:max-content;min-width:100%}
  th,td{padding:8px 10px;font-size:13px;white-space:nowrap}
  .summary{gap:6px}
  .pill{padding:2px 7px;font-size:10px}
  .brand-header img{max-height:32px;max-width:100px}
  .agency-name{font-size:15px}
}
@media (prefers-color-scheme: light) {
  :root:not([data-theme]) {
    --bg:#f6f8fa; --panel:#ffffff; --panel2:#f0f3f6; --fg:#0d1117; --muted:#586069; --border:#d0d7de;
    --crit-bg:#ffd6d6; --crit-fg:#67000d;
    --high-bg:#ffe1de; --high-fg:#5a1816;
    --med-bg:#fff0c2;  --med-fg:#5d4500;
    --low-bg:#dbeafe;  --low-fg:#133246;
    --info-bg:#eef0f2; --info-fg:#586069;
    --ok-bg:#dbf5e3;   --ok-fg:#133320;
  }
  a{color:#0969da}
}
@media print {
  @page{margin:1.5cm 1cm}
  body{background:#fff!important;color:#111!important;font-size:10pt}
  header,main,footer{background:#fff!important;color:#111!important}
  main{padding:0}
  table{font-size:10pt}
  th{background:#eee!important;color:#111!important;border:1px solid #999!important}
  td{border-bottom:1px solid #ccc!important}
  .pill,.spark{background:#eee!important;color:#111!important;border:1px solid #999!important}
  a{color:#0055cc;text-decoration:underline}
  tr{break-inside:avoid;page-break-inside:avoid}
}
{% if agency and brand and brand.primary_color %}
  /* brand.json override */
  body{--accent: {{ brand.primary_color }}}
  a{color:{{ brand.primary_color }}}
  .pill.high{background:{{ brand.primary_color }}22;color:{{ brand.primary_color }}}
{% endif %}
</style>
</head>
<body>
<header>
{% if agency and brand and (brand.agency_name or brand.logo_url) %}
  <div class="brand-header">
    {% if brand.logo_url %}<img src="{{ brand.logo_url }}" alt="{{ brand.agency_name or 'Agency logo' }}">{% endif %}
    {% if brand.agency_name %}<span class="agency-name">{{ brand.agency_name }}</span>{% endif %}
  </div>
{% endif %}
{% if agency %}
  <h1>Monthly security posture — {{ brand.client_name if brand and brand.client_name else 'site portfolio' }}</h1>
{% else %}
  <h1>WPSecScan — batch dashboard</h1>
{% endif %}
  <div class="meta">Generated {{ generated_at }} · {{ reports|length }} site(s) scanned</div>
  <div class="summary">
    <span class="pill crit">{{ totals.critical }} critical</span>
    <span class="pill high">{{ totals.high }} high</span>
    <span class="pill med">{{ totals.medium }} medium</span>
    <span class="pill low">{{ totals.low }} low</span>
    <span class="pill info">{{ totals.info }} info</span>
  </div>
</header>
<main>
<table>
<thead>
<tr>
  <th>Site</th>
  <th>Worst</th>
  {% if agency %}<th class="num">Score</th><th class="num">Δ vs prior</th><th>Trend</th>{% endif %}
  <th class="num">Crit</th>
  <th class="num">High</th>
  <th class="num">Med</th>
  <th class="num">Low</th>
  <th class="num">Info</th>
  <th class="num">Duration</th>
  <th>Per-site report</th>
</tr>
</thead>
<tbody>
{% for row in reports %}
  {% set sev = row.worst or 'ok' %}
  {% set short = 'crit' if sev=='critical' else ('med' if sev=='medium' else sev) %}
  <tr>
    <td>{{ row.target }}</td>
    <td><span class="pill {{ short }}">{{ sev|upper }}</span></td>
    {% if agency %}
      <td class="num">{{ row.risk_score }}/100</td>
      <td class="num">
        {% if row.delta_score is none %}—
        {% elif row.delta_score > 0 %}<span class="delta-up">+{{ row.delta_score }}</span>
        {% elif row.delta_score < 0 %}<span class="delta-dn">{{ row.delta_score }}</span>
        {% else %}<span class="delta-flat">0</span>{% endif %}
      </td>
      <td class="spark" title="{{ row.scan_count }} recent scan(s)">{{ row.spark }}</td>
    {% endif %}
    <td class="num crit">{{ row.summary.critical }}</td>
    <td class="num high">{{ row.summary.high }}</td>
    <td class="num med">{{ row.summary.medium }}</td>
    <td class="num low">{{ row.summary.low }}</td>
    <td class="num info">{{ row.summary.info }}</td>
    <td class="num">{{ row.duration_ms }} ms</td>
    <td><a href="{{ row.html_filename }}" target="_blank" rel="noopener noreferrer">open ↗</a></td>
  </tr>
{% endfor %}
</tbody>
</table>
</main>
{% if agency and brand and brand.footer_text %}
<footer>{{ brand.footer_text }}</footer>
{% endif %}
</body>
</html>
